# =========================================================================
# Voice agent — server-only secrets.
#
# These are read by the Netlify functions in netlify/functions/ and are NEVER
# exposed to the browser. Do NOT add a VITE_ prefix to any of them — Vite
# inlines every VITE_-prefixed variable into the client bundle, which would
# publish the key to anyone who opens devtools.
#
# Local:      copy this file to `.env` and fill it in, then run `netlify dev`
# Production: Netlify → Site settings → Environment variables
# =========================================================================

# --- Sarvam AI (STT + TTS + chat generation) -----------------------------
# REQUIRED. Sign up at https://www.sarvam.ai/ — free credits on signup, no
# card needed to start. This single key powers all three voice endpoints.
SARVAM_API_KEY=

# --- Google Gemini (RAG embeddings) --------------------------------------
# OPTIONAL. Get one free at https://aistudio.google.com/
# Without it, /api/embed returns 503, the client trips its circuit breaker,
# and the agent falls back to keyword retrieval — which works fine for a
# knowledge base this size. Add it later for semantic search; nothing else
# needs to change.
GEMINI_API_KEY=


# =========================================================================
# Origin policy — which browsers may call /api/*. Lives here, not in code.
# =========================================================================

# REQUIRED in production. Comma-separated canonical hostnames.
# Example: ALLOWED_ORIGINS=https://sonal-portfolio.netlify.app,https://sonalsingh.dev
ALLOWED_ORIGINS=

# Dev-only allow-list, layered in when NODE_ENV isn't production.
# Falls back to localhost:5173 / :8888 / :3000 when unset.
ALLOWED_DEV_ORIGINS=

# Regex SOURCE (no slashes, no flags) matching Netlify deploy-preview hosts,
# so branch and PR previews can call /api/* without per-deploy env updates.
# Leave empty to disable preview matching entirely.
# Example: PREVIEW_ORIGIN_PATTERN=^https:\/\/[a-z0-9-]+--sonal-portfolio\.netlify\.app$
PREVIEW_ORIGIN_PATTERN=
